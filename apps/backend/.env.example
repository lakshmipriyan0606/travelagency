# Copy to .env and fill in values. On Render/hosting, set these in the dashboard (Environment).

# Database
MONGO_URI=mongodb+srv://...

# Gmail (App Password — not your normal Gmail password)
# https://support.google.com/accounts/answer/185833
GMAIL_USER=your-service@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Google Sheet — Apps Script “Deploy as web app” URL (POST JSON)
GOOGLE_SHEET_BOOKING_WEBHOOK=https://script.google.com/macros/s/.../exec

# Optional: published JSON URL for package sync
# GOOGLE_SHEET_PACKAGE_DATA_URL=

# Alerts
ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_WHATSAPP=

# CORS — add your production frontend origin(s) in app.js allowedOrigins or CORS_ORIGIN

# Frontend URLs used in password-reset email links
# B2B_PORTAL_URL=http://localhost:3001
# ADMIN_URL=http://localhost:3002

# Optional: same token as admin metrics — GET /api/admin/queue/health with header x-metrics-token
# METRICS_TOKEN=
