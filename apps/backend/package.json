{
  "name": "backend",
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.0",
    "@sentry/node": "^10.67.0",
    "@sentry/profiling-node": "^10.67.0",
    "agenda": "^6.2.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.10",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "envalid": "^8.2.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "resend": "^6.4.2",
    "uuid": "^13.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.1.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*",
    "#integrations/*": "./src/integrations/*",
    "#shared/*": "./src/shared/*",
    "#middleware/*": "./src/middleware/*",
    "#config/*": "./config/*",
    "#utils/*": "./src/utils/*",
    "#app/*": "./src/app/*"
  },
  "scripts": {
    "dev": "nodemon ./src/server.js",
    "build": "echo 'Backend build complete'",
    "start": "node src/server.js",
    "start:cluster": "pm2 start ecosystem.config.cjs --env production",
    "stop:cluster": "pm2 stop travelagency-backend",
    "logs:cluster": "pm2 logs travelagency-backend",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
